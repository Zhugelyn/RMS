# Copy to .env and fill locally. Never commit .env.
TELEGRAM__BOTTOKEN=replace-with-telegram-bot-token
TELEGRAM__WEBHOOKSECRETTOKEN=
TELEGRAM__USEPOLLING=true
ASSISTANT__SERVICEKEY=replace-with-long-random-service-key

# Phase 2 Cursor SDK (optional). Without ApiKey assistant falls back to stub.
# MasterKey required only when ApiKey or EncryptedApiKey is set (>=16 chars).
CURSOR__APIKEY=
CURSOR__ENCRYPTEDAPIKEY=
CURSOR__MASTERKEY=
CURSOR__MODEL=composer-2.5
