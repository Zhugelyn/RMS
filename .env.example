# Copy to .env and fill locally. Never commit .env.
TELEGRAM__BOTTOKEN=replace-with-telegram-bot-token
TELEGRAM__WEBHOOKSECRETTOKEN=
TELEGRAM__USEPOLLING=true
ASSISTANT__SERVICEKEY=replace-with-long-random-service-key

# Phase 2 Cursor SDK (optional). Without ApiKey assistant falls back to stub.
# MasterKey required only when ApiKey or EncryptedApiKey is set (>=16 chars).
CURSOR__APIKEY=
CURSOR__ENCRYPTEDAPIKEY=
CURSOR__MASTERKEY=
CURSOR__MODEL=composer-2.5

# Phase 4 Instagram Research (placeholders — wiring in later slices).
# Postgres durable harness + research artifacts (snapshot/plan/episodes). Not RAG.
# POSTGRES__CONNECTIONSTRING=Host=postgres;Port=5432;Database=assistant;Username=assistant;Password=replace-me
# Instagram Graph API of OWN account only. No Apify. Never put token in Telegram/Mini App.
# INSTAGRAM__ACCESSTOKEN=
# INSTAGRAM__BUSINESSACCOUNTID=
# RESEARCH__SCHEDULEDAYS=14
# Local volume for Cursor GenerateImage via marketing pack (not OpenAI Images).
# RESEARCH__IMAGEVOLUMEPATH=/data/marketing-images
