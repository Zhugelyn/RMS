# Copy to .env and fill locally. Never commit .env.
TELEGRAM__BOTTOKEN=replace-with-telegram-bot-token
TELEGRAM__WEBHOOKSECRETTOKEN=
TELEGRAM__USEPOLLING=true
ASSISTANT__SERVICEKEY=replace-with-long-random-service-key

# Phase 2 Cursor SDK (optional). Without ApiKey assistant falls back to stub.
# MasterKey required only when ApiKey or EncryptedApiKey is set (>=16 chars).
CURSOR__APIKEY=
CURSOR__ENCRYPTEDAPIKEY=
CURSOR__MASTERKEY=
CURSOR__MODEL=composer-2.5

# Phase 4 Instagram Research.
# Postgres durable harness + research settings (ADR-008/010). Not RAG.
# Compose always wires ConnectionStrings__AssistantDb to the postgres service.
# Local `dotnet run` without ConnectionStrings__AssistantDb keeps in-process stores.
POSTGRES__PASSWORD=replace-with-strong-postgres-password
# Optional override for non-compose runs (never commit real values):
# ConnectionStrings__AssistantDb=Host=127.0.0.1;Port=5432;Database=assistant;Username=assistant;Password=replace-me

# Instagram Graph API of OWN account only (ADR-009). No Apify.
# Token: env/secret store only — never Telegram/Mini App/chat. Encrypt-at-rest at startup
# (AES-GCM) using Instagram:MasterKey or shared Cursor:MasterKey (≥16 chars).
# Without AccessToken assistant uses stub skip; compose stays green.
INSTAGRAM__ACCESSTOKEN=
INSTAGRAM__ENCRYPTEDACCESSTOKEN=
INSTAGRAM__MASTERKEY=
INSTAGRAM__IGUSERID=
INSTAGRAM__BUSINESSACCOUNTID=
# RESEARCH__SCHEDULEDAYS=14
# Gateway notify from assistant-api (compose sets Gateway__BaseUrl automatically):
# Gateway__BaseUrl=http://telegram-gateway:8080
# Gateway__ServiceKey=<same as ASSISTANT__SERVICEKEY>
# Local volume for Cursor GenerateImage via marketing pack (not OpenAI Images).
# Compose mounts named volume research-images at this path in bridge/api/gateway.
RESEARCH__IMAGEVOLUMEPATH=/data/marketing-images

# Optional hardening knobs (defaults are safe):
# TELEGRAM__INITDATAMAXAGESECONDS=86400
# INSTAGRAM__DEFAULTMEDIALIMIT=25
